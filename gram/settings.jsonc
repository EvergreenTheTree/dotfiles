// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "sync_kill_ring": "none",
  "dap": {
    "CodeLLDB": {
      "enable_auto_updates": true,
      "allow_binary_download": true
    },
    "Debugpy": {
      "enable_auto_updates": true,
      "allow_binary_download": true
    }
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "languages": {
    "Rust": {
      "preferred_line_length": 100,
      "soft_wrap": "preferred_line_length"
    }
  },
  "terminal": {
    "shell": {
      "program": "fish"
    },
    "font_size": 12.0,
    "font_family": "Maple Mono NL"
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true
  },
  "title_bar": {
    "show_menus": true
  },
  "status_bar": {
    "icon_size": "large"
  },
  "show_whitespaces": "all",
  "sticky_scroll": {
    "enabled": true
  },
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Maple Mono NL",
  "node": {
    "allow_binary_download": true,
    "allow_prettier_download": true,
    "allow_npm_install": true
  },
  "ui_font_family": "Noto Sans",
  "restore_on_startup": "last_workspace",
  "lsp": {
    "bash-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "clangd": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": false,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "lua-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "yaml-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "package-version-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "json-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "rust-analyzer": {
      "binary": {
        "path": "/usr/bin/rustup",
        "arguments": ["run", "nightly", "rust-analyzer"]
      },
      "enable_lsp_tasks": true
    }
  },
  "base_keymap": "Minimal",
  "vim_mode": true,
  "icon_theme": "Gram (Default)",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Catppuccin Mocha",
  },
}
